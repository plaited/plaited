{
  "name": "plaited-workspace",
  "private": true,
  "workspaces": [
    "framework",
    "adapters/*"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "scripts": {
    "check": "cd framework && bun run check",
    "commit": "cz",
    "prepare": "git config core.hooksPath .hooks",
    "test": "cd framework && bun test"
  },
  "lint-staged": {
    "*.{js,cjs,jsx,tsx,ts}": [
      "bunx biome check --write"
    ],
    "package.json": [
      "format-package -w"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "commitlint": "21.0.1",
    "cz-conventional-changelog": "3.3.0",
    "format-package": "7.0.0",
    "lint-staged": "17.0.5",
    "varlock": "^1.2.0",
    "@varlock/1password-plugin": "^1.1.0"
  }
}
