{
  "name": "onbraid-workspace",
  "private": true,
  "workspaces": [
    "framework"
  ],
  "scripts": {
    "commit": "cz",
    "prepare": "git config core.hooksPath framework/.hooks",
    "test": "cd framework && bun test",
    "check": "cd framework && bun run check"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "commitlint": "21.0.1",
    "cz-conventional-changelog": "3.3.0",
    "format-package": "7.0.0",
    "lint-staged": "17.0.5",
    "varlock": "^1.2.0",
    "@varlock/1password-plugin": "^1.1.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,cjs,jsx,tsx,ts}": [
      "bunx biome check --write"
    ],
    "package.json": [
      "format-package -w"
    ]
  }
}
